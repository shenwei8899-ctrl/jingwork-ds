{
  "name": "@deepseek-ai/dsh-super-agent",
  "description": "Chat task orchestration with persistent goals and delegated execution",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
