#!/bin/sh
# Run the installed CLI with JingWork's private data directories.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
export DSH_HOME="${HOME:?Home directory is unavailable}/.jingwork"
export DSH_AGENTS_HOME="$DSH_HOME/agents"
ELECTRON_RUN_AS_NODE=1 exec "$resources/../MacOS/JingWork" --expose-internals "$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js" "$@"
